{
    "version": "2.0.0",
    "tasks": [
		{
            "label": "cmake ..",
            "type": "shell",
            "options": {
                "cwd": "${fileDirname}/../build",
                "shell": {
                    "executable": "C:\\msys64\\usr\\bin\\bash.exe",
                    "args": [
                        "-l",
                        "-c"
                    ]
                },
                "env": {
                    "MSYSTEM": "UCRT64",
                    "CHERE_INVOKING": "1"
                }
            },
            "command": "cmake ..",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "cmake build debug",
            "type": "shell",
            "options": {
                "cwd": "${fileDirname}/../build",
                "shell": {
                    "executable": "C:\\msys64\\usr\\bin\\bash.exe",
                    "args": [
                        "-l",
                        "-c"
                    ]
                },
                "env": {
                    "MSYSTEM": "UCRT64",
                    "CHERE_INVOKING": "1"
                }
            },
            "command": "cmake -S .. -B ./debug -G Ninja -DCMAKE_BUILD_TYPE=Debug && cmake --build ./debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "cmake build release",
            "type": "shell",
            "options": {
                "cwd": "${fileDirname}/../build",
                "shell": {
                    "executable": "C:\\msys64\\usr\\bin\\bash.exe",
                    "args": [
                        "-l",
                        "-c"
                    ]
                },
                "env": {
                    "MSYSTEM": "UCRT64",
                    "CHERE_INVOKING": "1"
                }
            },
            "command": "cmake -S .. -B ./release -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build ./release",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}